{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./src/*",
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "src/App.tsx",
    "src/APITester.tsx",
    "src/frontend.tsx",
    "src/index.ts",
    "src/index.css",
    "src/index.html",
    "src/logo.svg",
    "src/react.svg",
    "src/components/parallax-scroll-view.tsx",
    "src/components/ui/icon-symbol.tsx",
    "src/hooks/use-theme-color.ts",
    "node_modules"
  ]
}
